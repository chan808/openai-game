    "node": ">=22.12.0 <23"
  },
  "devDependencies": {
    "typescript": "~6.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10",
    "wrangler": "^4.123.0"
  },
  "dependencies": {
    "phaser": "4.2.1"
  }
}
